# --- Backend ---
FLASK_ENV=development            # set to "production" on the server
SECRET_KEY=change-me-to-a-long-random-string   # python -c "import secrets;print(secrets.token_hex(32))"
# MySQL (production):   mysql+pymysql://USER:PASSWORD@HOST:3306/phishguard
# Leave unset in development to use a local SQLite file.
DATABASE_URL=mysql+pymysql://phishguard:password@localhost:3306/phishguard
CORS_ORIGINS=http://localhost:5173
JWT_EXPIRES_HOURS=8
ADMIN_EMAIL=admin@example.com    # the account registered with this email becomes admin
RATE_LIMIT_SCAN_PER_MIN=10
RATE_LIMIT_AUTH_PER_MIN=10
# --- Frontend (frontend/.env) ---
VITE_API_URL=http://localhost:5000
TRUST_PROXY=0                    # set to 1 when running behind a reverse proxy (Render, nginx)
